[
  {
    "cue": 1,
    "start": 0.3,
    "end": 4.9,
    "spoken_seconds": 3.774,
    "speed": 1.0,
    "fits": true,
    "say": "تقنيات الفضاء، خدمات من السما، تسهّل حياتنا على الأرض."
  },
  {
    "cue": 2,
    "start": 5.3,
    "end": 10.0,
    "spoken_seconds": 4.775,
    "speed": 1.027,
    "fits": true,
    "say": "أول شي، الأقمار الصناعية. الصاروخ يحمل القمر، ويحطّه في مداره."
  },
  {
    "cue": 3,
    "start": 10.2,
    "end": 14.7,
    "spoken_seconds": 3.002,
    "speed": 1.0,
    "fits": true,
    "say": "وهناك يدور حول الأرض، ويخدمنا ليل ونهار."
  },
  {
    "cue": 4,
    "start": 15.2,
    "end": 20.4,
    "spoken_seconds": 5.153,
    "speed": 1.001,
    "fits": true,
    "say": "ثاني شي، الاتصالات. نرسل الإشارة للقمر، وهو يرجّعها لمكان ثاني."
  },
  {
    "cue": 5,
    "start": 20.6,
    "end": 24.7,
    "spoken_seconds": 2.989,
    "speed": 1.0,
    "fits": true,
    "say": "فيوصل الإنترنت والبث، حتى لأبعد القرى."
  },
  {
    "cue": 6,
    "start": 25.2,
    "end": 30.35,
    "spoken_seconds": 4.39,
    "speed": 1.0,
    "fits": true,
    "say": "ثالث شي، تحديد المواقع. تلفونك يستقبل إشارات من عدة أقمار."
  },
  {
    "cue": 7,
    "start": 30.55,
    "end": 34.7,
    "spoken_seconds": 3.094,
    "speed": 1.0,
    "fits": true,
    "say": "ويحسب بعده عن كل قمر، فيعرف مكانك بالضبط."
  },
  {
    "cue": 8,
    "start": 35.2,
    "end": 40.3,
    "spoken_seconds": 4.551,
    "speed": 1.0,
    "fits": true,
    "say": "رابع شي، رصد الأرض. الأقمار تصوّر الطقس، وتتابع الأعاصير."
  },
  {
    "cue": 9,
    "start": 40.5,
    "end": 44.7,
    "spoken_seconds": 3.138,
    "speed": 1.0,
    "fits": true,
    "say": "وتراقب الزراعة والمياه، وتساعد فرق الطوارئ."
  },
  {
    "cue": 10,
    "start": 45.2,
    "end": 50.2,
    "spoken_seconds": 4.812,
    "speed": 1.0,
    "fits": true,
    "say": "وآخر شي، الاستكشاف. نكتشف القمر والمريخ، ونبني أقمار صغيرة."
  },
  {
    "cue": 11,
    "start": 50.4,
    "end": 53.9,
    "spoken_seconds": 3.396,
    "speed": 1.0,
    "fits": true,
    "say": "وفيه فرص للشباب، في الهندسة وتحليل البيانات."
  },
  {
    "cue": 12,
    "start": 54.2,
    "end": 59.7,
    "spoken_seconds": 4.256,
    "speed": 1.0,
    "fits": true,
    "say": "تقنيات الفضاء، من السما، لخدمة الأرض. نحو مجتمع رقمي."
  }
]