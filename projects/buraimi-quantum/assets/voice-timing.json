[
  {
    "cue": 1,
    "start": 0.3,
    "end": 4.9,
    "spoken_seconds": 4.041,
    "speed": 1.0,
    "fits": true,
    "say": "الحوسبة الكمية، طريقة جديدة ومختلفة تمامًا للحساب."
  },
  {
    "cue": 2,
    "start": 5.3,
    "end": 10.0,
    "spoken_seconds": 4.695,
    "speed": 1.01,
    "fits": true,
    "say": "أول شي، الكيوبت. البت العادي يا صفر يا واحد، مثل عملة على الطاولة."
  },
  {
    "cue": 3,
    "start": 10.2,
    "end": 14.7,
    "spoken_seconds": 4.505,
    "speed": 1.012,
    "fits": true,
    "say": "أما الكيوبت، مثل عملة تدور. صفر وواحد مع بعض، لين نقيسه."
  },
  {
    "cue": 4,
    "start": 15.2,
    "end": 20.4,
    "spoken_seconds": 4.348,
    "speed": 1.0,
    "fits": true,
    "say": "ثاني شي، التشابك. نربط كيوبتين مع بعض، حتى لو كانوا بعيدين."
  },
  {
    "cue": 5,
    "start": 20.6,
    "end": 24.7,
    "spoken_seconds": 2.887,
    "speed": 1.0,
    "fits": true,
    "say": "ولما نقيس واحد، نعرف حالة الثاني على طول."
  },
  {
    "cue": 6,
    "start": 25.2,
    "end": 30.35,
    "spoken_seconds": 3.737,
    "speed": 1.0,
    "fits": true,
    "say": "ثالث شي، كيف يحسب؟ الحاسوب العادي يجرّب طريق ورا طريق."
  },
  {
    "cue": 7,
    "start": 30.55,
    "end": 34.7,
    "spoken_seconds": 3.821,
    "speed": 1.0,
    "fits": true,
    "say": "والكمي يتعامل مع احتمالات واجد مع بعض، ويقوّي الجواب الصح."
  },
  {
    "cue": 8,
    "start": 35.2,
    "end": 40.3,
    "spoken_seconds": 4.246,
    "speed": 1.0,
    "fits": true,
    "say": "رابع شي، وين ينفع؟ في اكتشاف الأدوية، والمواد الجديدة."
  },
  {
    "cue": 9,
    "start": 40.5,
    "end": 44.7,
    "spoken_seconds": 2.759,
    "speed": 1.0,
    "fits": true,
    "say": "وفي تنظيم الطرق والشحن، وحماية البيانات."
  },
  {
    "cue": 10,
    "start": 45.2,
    "end": 50.2,
    "spoken_seconds": 4.524,
    "speed": 1.0,
    "fits": true,
    "say": "ووين وصلنا؟ الأجهزة تشتغل في برودة شديدة، وبعدها في المختبرات."
  },
  {
    "cue": 11,
    "start": 50.4,
    "end": 53.9,
    "spoken_seconds": 3.488,
    "speed": 1.011,
    "fits": true,
    "say": "وما بتاخذ مكان حاسوبك، لكن بتكمّله في المسائل الصعبة."
  },
  {
    "cue": 12,
    "start": 54.2,
    "end": 59.7,
    "spoken_seconds": 4.522,
    "speed": 1.0,
    "fits": true,
    "say": "الحوسبة الكمية، علم اليوم، وتقنية الغد. نحو مجتمع رقمي."
  }
]