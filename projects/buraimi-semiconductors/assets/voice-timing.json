[
  {
    "cue": 1,
    "start": 0.3,
    "end": 4.9,
    "spoken_seconds": 3.864,
    "speed": 1.0,
    "fits": true,
    "say": "أشباه الموصلات، العقل الصغير اللي يشغّل كل جهاز حوالينا."
  },
  {
    "cue": 2,
    "start": 5.3,
    "end": 10.0,
    "spoken_seconds": 5.097,
    "speed": 1.096,
    "fits": true,
    "say": "أول شي، ما هي؟ النحاس يوصّل الكهربا دايمًا، والمطاط يمنعها دايمًا."
  },
  {
    "cue": 3,
    "start": 10.2,
    "end": 14.7,
    "spoken_seconds": 4.199,
    "speed": 1.0,
    "fits": true,
    "say": "أما السيليكون، فنتحكم فيه. مرة يوصّل، ومرة يمنع."
  },
  {
    "cue": 4,
    "start": 15.2,
    "end": 20.4,
    "spoken_seconds": 4.842,
    "speed": 1.0,
    "fits": true,
    "say": "ثاني شي، الترانزستور. مفتاح صغير واجد، يفتح الكهربا ويقفلها."
  },
  {
    "cue": 5,
    "start": 20.6,
    "end": 24.7,
    "spoken_seconds": 3.93,
    "speed": 1.0,
    "fits": true,
    "say": "مقفول يعني صفر، ومفتوح يعني واحد. وهذي لغة الحاسوب."
  },
  {
    "cue": 6,
    "start": 25.2,
    "end": 30.35,
    "spoken_seconds": 4.649,
    "speed": 1.0,
    "fits": true,
    "say": "ثالث شي، الشريحة. السيليكون يطلع من الرمل، ونسوي منه قرص رقيق."
  },
  {
    "cue": 7,
    "start": 30.55,
    "end": 34.7,
    "spoken_seconds": 3.576,
    "speed": 1.0,
    "fits": true,
    "say": "وننقش عليه مليارات المفاتيح، في شريحة بحجم الظفر."
  },
  {
    "cue": 8,
    "start": 35.2,
    "end": 40.3,
    "spoken_seconds": 4.403,
    "speed": 1.0,
    "fits": true,
    "say": "رابع شي، وين نحصلها؟ في تلفونك، وفي الحاسوب، وفي السيارة."
  },
  {
    "cue": 9,
    "start": 40.5,
    "end": 44.7,
    "spoken_seconds": 3.102,
    "speed": 1.0,
    "fits": true,
    "say": "وفي الأجهزة الطبية، والألواح الشمسية بعد."
  },
  {
    "cue": 10,
    "start": 45.2,
    "end": 50.2,
    "spoken_seconds": 4.231,
    "speed": 1.0,
    "fits": true,
    "say": "وليش تهمنا؟ لأنها أساس الذكاء الاصطناعي، والاقتصاد الرقمي."
  },
  {
    "cue": 11,
    "start": 50.4,
    "end": 53.9,
    "spoken_seconds": 3.251,
    "speed": 1.0,
    "fits": true,
    "say": "وفيها فرص حلوة للشباب، في التصميم والهندسة."
  },
  {
    "cue": 12,
    "start": 54.2,
    "end": 59.7,
    "spoken_seconds": 5.083,
    "speed": 1.0,
    "fits": true,
    "say": "أشباه الموصلات، صغيرة في الحجم، كبيرة في الأثر. نحو مجتمع رقمي."
  }
]